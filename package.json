  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
     "build": "tsc",
     "start": "node dist/src/server.js",
     "migration:run": "node ./node_modules/typeorm/cli.js migration:run -d dist/src/config/data-source.js",
     "migration:revert": "node ./node_modules/typeorm/cli.js migration:revert -d dist/src/config/data-source.js",
     "migration:generate": "node ./node_modules/typeorm/cli.js migration:generate dist/src/migrations/Init -d dist/src/config/data-source.js"

  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shiv-Narlawar/user-management-backend.git"
